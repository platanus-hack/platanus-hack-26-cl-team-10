{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "dev:celular": "vite --host --mode celular",
    "build:funcion": "tsc -p tsconfig.funcion.json",
    "desplegar": "npm run build:funcion && vercel build --prod && vercel deploy --prebuilt --prod"
  },
  "dependencies": {
    "@fontsource-variable/bitcount-prop-single": "^5.3.0",
    "@mantine/core": "^9.8.2",
    "@mantine/hooks": "^9.8.2",
    "@tabler/icons-react": "^3.52.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.33",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
