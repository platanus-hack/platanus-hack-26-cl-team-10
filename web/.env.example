# Copia lo que necesites a web/.env.local (git lo ignora).

# La voz de los avisos: /api/voz la pide a ElevenLabs desde el servidor del front.
# Sin prefijo VITE_: así nunca llega al navegador.
ELEVENLABS_API_KEY=
# Opcional: otra voz (por defecto «George», la de elevenlabs-tts/tts.py).
ELEVENLABS_VOICE_ID=

# Sin mock (`npm run dev`): la API del equipo de Francisco. Con mock: `npm run dev:mock`.
VITE_API_URL=https://34-176-44-192.sslip.io
VITE_EDGE_ID=edge-1
# Por defecto /api/voz, en el mismo servidor del front.
VITE_VOZ_URL=
